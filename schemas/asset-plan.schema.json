{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "background": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "transparent"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "chroma"
            },
            "color": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "reason": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "color",
            "reason"
          ],
          "additionalProperties": false
        }
      ]
    },
    "parts": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "view": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "material": {
            "type": "string",
            "minLength": 1
          },
          "depth": {
            "type": "string",
            "enum": [
              "near",
              "far",
              "center"
            ]
          },
          "anatomy": {
            "type": "string",
            "minLength": 1
          },
          "attachment": {
            "type": "string",
            "enum": [
              "region",
              "mesh"
            ]
          },
          "influences": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          }
        },
        "required": [
          "id",
          "view",
          "description",
          "material",
          "depth",
          "anatomy",
          "attachment",
          "influences"
        ],
        "additionalProperties": false
      }
    },
    "joins": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "bone": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "parts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9_-]+$"
            }
          },
          "strategy": {
            "type": "string",
            "enum": [
              "continuous-mesh",
              "covered-overlap"
            ]
          },
          "owner": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "bone",
          "parts",
          "strategy",
          "owner",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "drawOrder": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9_-]+$"
      },
      "additionalProperties": {
        "minItems": 1,
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$"
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "background",
    "parts",
    "joins",
    "drawOrder"
  ],
  "additionalProperties": false
}
