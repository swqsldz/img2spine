{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "master": {
      "type": "string"
    },
    "masterAlignment": {
      "type": "object",
      "properties": {
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "basis": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "scale",
        "x",
        "y",
        "basis"
      ],
      "additionalProperties": false
    },
    "assets": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "view": {
            "default": "front",
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]+$"
          },
          "facing": {
            "default": "neutral",
            "type": "string",
            "enum": [
              "left",
              "right",
              "neutral"
            ]
          },
          "depth": {
            "default": "center",
            "type": "string",
            "enum": [
              "near",
              "far",
              "center"
            ]
          },
          "anatomy": {
            "type": "object",
            "properties": {
              "side": {
                "type": "string",
                "enum": [
                  "left",
                  "right",
                  "center"
                ]
              },
              "pair": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9_-]+$"
              },
              "surface": {
                "type": "string",
                "enum": [
                  "outer",
                  "inner",
                  "palm",
                  "back",
                  "neutral"
                ]
              },
              "symmetryReason": {
                "type": "string",
                "minLength": 15
              }
            },
            "required": [
              "side",
              "pair",
              "surface"
            ],
            "additionalProperties": false
          },
          "trimAlphaThreshold": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 254
          },
          "sourceRect": {
            "type": "object",
            "properties": {
              "left": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "top": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "width": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "height": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "left",
              "top",
              "width",
              "height"
            ],
            "additionalProperties": false
          },
          "placement": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "rotation": {
                "default": 0,
                "type": "number"
              },
              "mirror": {
                "default": false,
                "type": "boolean"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height",
              "rotation",
              "mirror"
            ],
            "additionalProperties": false
          },
          "landmarks": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ]
            }
          },
          "generation": {
            "type": "object",
            "properties": {
              "mode": {
                "type": "string",
                "enum": [
                  "builtin-imagegen",
                  "provided",
                  "synthetic-test"
                ]
              },
              "prompt": {
                "type": "string"
              },
              "reference": {
                "type": "string"
              }
            },
            "required": [
              "mode",
              "prompt"
            ],
            "additionalProperties": false
          },
          "sha256": {
            "type": "string"
          },
          "normalizedFile": {
            "type": "string"
          },
          "trim": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "width": {
                "type": "number"
              },
              "height": {
                "type": "number"
              },
              "originalWidth": {
                "type": "number"
              },
              "originalHeight": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y",
              "width",
              "height",
              "originalWidth",
              "originalHeight"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "file",
          "view",
          "facing",
          "depth",
          "trimAlphaThreshold",
          "placement",
          "landmarks",
          "generation"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "assets"
  ],
  "additionalProperties": false
}
